# VetVoice RAG — env config (copy to .env and fill in)
#
# ВСЕ переменные имеют префикс VETVOICE_. Значения отсюда перекрывают
# configs/config.yaml. Префикс можно не указывать только для HF_TOKEN и
# GLM_API_KEY — они читаются и так (совместимость).

# ─── Z AI / GLM ────────────────────────────────────────────────────────────
# Ключ: https://z.ai/manage-apikey/apikey-list
GLM_API_KEY=your_glm_api_key_here

# Публичный endpoint. internal-api.z.ai НЕ использовать — приватный IP.
VETVOICE_ZAI_BASE_URL=https://api.z.ai/api/paas/v4
VETVOICE_LLM_MODEL=glm-4.5-flash
VETVOICE_VLM_MODEL=glm-4.6v

# ─── HuggingFace ───────────────────────────────────────────────────────────
# Нужен только для --upload и приватных репо. База знаний публичная.
HF_TOKEN=

# ─── RAG ───────────────────────────────────────────────────────────────────
# VETVOICE_KB_DIR=/app/knowledge_base
# VETVOICE_RAG_TOP_K=5
# VETVOICE_RAG_MIN_SCORE=0.01

# ─── Безопасность API ──────────────────────────────────────────────────────
# Ключи через запятую. Если пусто — API открыт (dev-режим), в логе будет
# предупреждение и /v1/health вернёт auth_enabled=false.
VETVOICE_API_KEYS=
VETVOICE_RATE_LIMIT_PER_MINUTE=30
VETVOICE_MAX_TOKENS_LIMIT=2048

# ─── Server ────────────────────────────────────────────────────────────────
PORT=7860
VETVOICE_LOG_LEVEL=INFO
